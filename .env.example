# Base URL of the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api

# Firebase (Google sign-in). Copy from Firebase console → Project settings → Your apps.
# Leave blank to hide the Google button. These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics when set.
VITE_FIREBASE_MEASUREMENT_ID=
