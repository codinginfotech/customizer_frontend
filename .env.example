# ============================================================================
# Makely web — environment
# Local development values. On the deploy platform, paste this file into the
# service's variables: VITE_* are consumed as Docker build args, the rest are
# read by the nginx container at start.
# ============================================================================

# --- Backend location -------------------------------------------------------
# Where the LOCAL dev server (npm run dev) forwards /api and /uploads. Change
# this to point local dev at another API, e.g. the deployed one:
#   VITE_BACKEND_URL=https://customizer-backend-xxxx.up.railway.app
# The browser still talks to localhost:5173, so cookies and CORS keep working.
# (Dev only — in the container nginx uses API_UPSTREAM below instead.)
VITE_BACKEND_URL=http://localhost:4000

# --- Build-time (Vite inlines these into the bundle) ------------------------
# Base URL the app calls the API on. Keep "/api" (same-origin, proxied) unless
# the browser must call the API directly on another domain — then set the
# full URL (e.g. https://api.example.com/api) AND set CLIENT_URL on the API.
VITE_API_URL=/api

# Firebase (Google sign-in). Public web-app identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Container runtime (nginx; ignored by the local Vite dev server) --------
# Port nginx listens on. PROD: most platforms inject PORT themselves.
PORT=80
# Where nginx proxies /api and /uploads. Docker compose: the "backend" service.
# PROD: the API service's private/internal hostname, e.g.
#   http://customizer-backend.railway.internal:4000
API_UPSTREAM=http://backend:4000
